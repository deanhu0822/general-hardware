# Server-only inference selection: mock, huggingface, nvidia-build, or local.
# Keep secrets in .env.local or deployment settings; no provider credential is
# read by a browser component.
FORMA_INFERENCE_PROVIDER=mock

# Hugging Face Inference Providers. Create a fine-grained token with
# "Make calls to Inference Providers" permission and store it only server-side.
HF_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1
HF_REASONING_MODEL=openai/gpt-oss-120b:fastest
HF_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct:fastest
HF_ALLOW_MOCK_FALLBACK=true

# NVIDIA Build provider.
NVIDIA_API_KEY=
NVIDIA_BUILD_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=
NVIDIA_GENERATION_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_PARSE_MODEL=
NVIDIA_BUILD_ALLOW_MOCK_FALLBACK=true
NVIDIA_BUILD_STRUCTURED_MODE=auto
# Interpreter with product_pipeline/requirements-inference.txt installed.
FORMA_PYTHON_BIN=python
# Optional hosted bridge endpoint. Vercel automatically uses /api/nvidia_bridge
# on its own deployment; set this only for a separate private Python service.
FORMA_NVIDIA_BRIDGE_URL=

# Server-only NemoClaw orchestration backend base URL. Forma appends /generate.
NEMOCLAW_BACKEND_URL=

# Optional local NVIDIA NIM endpoints. Set FORMA_INFERENCE_PROVIDER=local to use
# these. When omitted, Forma Labs stays in explicit deterministic mock mode.
FORMA_REASONING_URL=
FORMA_VISION_URL=
FORMA_PARSE_URL=

# Local OpenCAD services. Keep these server-side; the Next routes proxy browser
# requests so engineering geometry does not need to leave the workstation.
OPENCAD_URL=http://127.0.0.1:8000
OPENCAD_VIEWPORT_URL=http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# J12 Review Packet business (see docs/handoff/SETUP.md)
# ---------------------------------------------------------------------------
# Durable single-host storage shared with the engineering workspace. Required
# in production; never on ephemeral/serverless disk.
# FORMA_CHANGE_DB=/absolute/durable/path/caid.sqlite
# Exact public origin for CSRF/origin checks on all POST routes.
# CAID_ORIGIN=https://your-exact-public-origin.example

# Offer: one configurable product. $29 is an unvalidated pricing hypothesis.
CAID_OFFER_AMOUNT=29.00
CAID_OFFER_CURRENCY=usd
CAID_OFFER_PRICE_AUTHORIZED=false
CAID_CLARIFICATION_LIMIT=1

# Shared demo customer on the sign-in page (one click creates it if needed).
# Set CAID_DEMO_ACCOUNT=false before a public launch that should not offer a shared account.
CAID_DEMO_ACCOUNT=true
CAID_DEMO_EMAIL=demo@caid.test
CAID_DEMO_PASSWORD=demo-packet-2026
CAID_DEMO_NAME=Demo customer

# Runtime model: Claude Opus 5.5 through the pinned Claude Agent SDK.
# Credentials come from the Claude Code login (or ANTHROPIC_API_KEY) available
# to the server process; they are separate from the Cursor build subscription.
CAID_RUNNER=opus                      # opus | test-double (test-double is refused in production unless CAID_ALLOW_TEST_DOUBLE=true)
CAID_RUNTIME_MODEL=claude-opus-5-5    # exact id verified via the SDK's supportedModels()
# Versioned adaptive effort policy (lib/packets/policy.ts). medium was the
# lowest effort passing all frozen gates on the 4-case evaluation of
# 2026-10-24 (12 observations, 1 repeat per cell; see docs/handoff/evaluation).
# Set EVALUATED=false to mark the default provisional again after any change.
CAID_RUNTIME_DEFAULT_EFFORT=medium    # low | medium | high | xhigh | max
CAID_RUNTIME_MAX_EFFORT=high          # ceiling for the single escalation
CAID_RUNTIME_EFFORT_EVALUATED=true
CAID_RUNTIME_EFFORT_EVALUATION_ID=effort-evaluation-2026-10-24T22-21-17-679Z.rescored
# Cumulative per-order limits across attempts, repair and escalation.
CAID_RUN_BUDGET_USD=3
CAID_RUN_MIN_RESERVE_USD=0.25
CAID_RUN_MAX_TOOL_CALLS=12
CAID_RUN_DEADLINE_MS=600000
CAID_RUN_MAX_TURNS=40
CAID_CLARIFY_BUDGET_USD=1
CAID_WORKER=on                        # off disables the in-process worker

# Payments: Whop (sandbox by default) or the labeled simulated test double.
CAID_PAYMENTS_PROVIDER=whop           # whop | simulated (simulated is refused in production unless CAID_ALLOW_SIMULATED_PAYMENTS=true)
WHOP_API_KEY=
WHOP_COMPANY_ID=                      # biz_...
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=                      # optional prod_...
WHOP_SANDBOX=true
CAID_SIMULATED_WEBHOOK_SECRET=        # ≥16 chars, only for the simulated provider
# CAID_ALLOW_STAFF_ORDERS=true        # let owner/reviewer accounts buy packets (local testing only)

# Terac completion callback host (from the hosted MCP responses).
TERAC_CALLBACK_HOST=https://terac.com
